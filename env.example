# Plantilla de variables de entorno.
# Copiar a `.env` y completar. La clave NUNCA viaja al front, al repo ni a los logs.
#
# Proveedor: minimax | anthropic | openai | auto
#   minimax  -> MiniMax (endpoint compatible con Anthropic, recomendado por MiniMax)
#   auto     -> usa minimax si hay MINIMAX_API_KEY, anthropic si hay ANTHROPIC_API_KEY,
#               openai si hay OPENAI_API_KEY; si no hay ninguna, modo determinista local.
LLM_PROVIDER=minimax

# ---------------------------------------------------------------------------
# MINIMAX (plan M)
#
# La credencial del plan M es la "Subscription Key" que se ve en
# Facturacion > M Plan (platform.minimax.io/console/plan). Se envia como
# token Bearer. No hace falta Group ID (dejarlo vacio).
#
# Endpoint por defecto (Anthropic-compatible, el recomendado por MiniMax):
#   https://api.minimax.io/anthropic/v1/messages
# Protocolo alterno compatible con OpenAI:
#   https://api.minimax.io/v1/chat/completions   (MINIMAX_PROTOCOLO=openai)
# ---------------------------------------------------------------------------
MINIMAX_API_KEY=
MINIMAX_PROTOCOLO=anthropic
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL_MINIMAX=MiniMax-M3.1-Flash

# ---------------------------------------------------------------------------
# Alternativas (solo si vas a usarlas)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_ANTHROPIC=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_OPENAI=gpt-4.1-mini

# Tope de iteraciones herramienta -> modelo por turno (CA1).
MAX_ITERACIONES=25

# Tope de tokens estimados por sesion: nadie gasta la clave sin limite.
MAX_TOKENS_SESION=120000

# Fecha de ejecucion para evaluar vigencias de soportes.
# Vacio = se usa la fecha de cada caso (determinista, recomendado para la defensa).
FECHA_EJECUCION=

HOST=0.0.0.0
PORT=3000
PUERTO_PUBLICO=3000
